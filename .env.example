# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default; PostgreSQL in production, e.g. postgres://user:pass@host:5432/webmoris
DATABASE_URL=sqlite:///db.sqlite3

# Admin lives here instead of /admin/ (keep the trailing slash)
ADMIN_URL=manage-webmoris/

# Production only
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Webmoris <no-reply@example.com>

# Leads
LEADS_NOTIFY_EMAIL=
LEADS_RATE_LIMIT=5
# Reverse proxies in front of Django (1 behind Nginx); used to find the visitor IP for rate limits
TRUSTED_PROXY_COUNT=0
# Shared cache for rate limits in production, e.g. dbcache://django_cache or redis://localhost:6379/1
CACHE_URL=locmemcache://
# Private uploads (quote attachments, payment proofs) — never served publicly
# PRIVATE_MEDIA_ROOT=/srv/webmoris/private_media
# Optional Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Payments — PayPal REST app (developer.paypal.com). PayPal is hidden while these are empty.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
ORDERS_NOTIFY_EMAIL=
