# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default; PostgreSQL in production, e.g. postgres://user:pass@host:5432/webmoris
DATABASE_URL=sqlite:///db.sqlite3

# Admin lives here instead of /admin/ (keep the trailing slash)
ADMIN_URL=manage-webmoris/

# Production only
CSRF_TRUSTED_ORIGINS=https://example.com
SECURE_SSL_REDIRECT=True
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Webmoris <no-reply@example.com>
