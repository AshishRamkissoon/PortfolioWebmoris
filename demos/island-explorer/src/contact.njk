---
layout: layouts/base.njk
title: Contact
section: contact
heroHeader: true
---
{% set heroPhoto = "south-1" %}{% set heroEyebrow = "Contact" %}{% set heroTitle = "Let's plan your day out" %}
{% set heroText = "Questions about a tour, a private group or a special occasion? We reply within a few hours." %}
{% include "partials/page-hero.njk" %}

<section class="container-x mt-20 grid gap-12 lg:grid-cols-[1.3fr_1fr]">
  <form class="card space-y-5 p-8 sm:p-10" action="/contact/" method="post" data-reveal>
    <h2 class="text-3xl font-semibold">Send us a message</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div><label class="label" for="name">Name</label><input class="field" id="name" name="name" required autocomplete="name"></div>
      <div><label class="label" for="c-email">Email</label><input class="field" id="c-email" name="email" type="email" required autocomplete="email"></div>
    </div>
    <div>
      <label class="label" for="tour">Tour</label>
      <select class="field" id="tour" name="tour"><option>Not sure yet</option>{% for tour in tours %}<option>{{ tour.title }}</option>{% endfor %}</select>
    </div>
    <div><label class="label" for="message">Message</label><textarea class="field" id="message" name="message" rows="5" required></textarea></div>
    <button type="submit" class="btn btn-coral px-8 py-4 text-base" data-magnetic>Send message</button>
  </form>

  <aside class="space-y-6">
    <div class="card p-8" data-reveal>
      <h2 class="font-body text-lg font-semibold">Talk to us</h2>
      <ul class="mt-5 space-y-4 text-ink-700">
        <li class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-xl bg-lagoon-100">☎</span>{{ site.phone }}</li>
        <li class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-xl bg-lagoon-100">@</span>{{ site.email }}</li>
        <li class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-xl bg-lagoon-100">⌂</span>{{ site.address }}</li>
      </ul>
      {# In a client's live site this opens WhatsApp; in the demo it leads to the Webmoris enquiry form. #}
      <a href="{{ site.agencyUrl }}/en/contact/ready-made/{{ site.templateSlug }}/" target="_blank" rel="noopener"
         class="btn mt-7 w-full bg-[#25d366] py-4 text-base text-white hover:brightness-95">Chat on WhatsApp</a>
      <p class="mt-2 text-center text-xs text-ink-500">Demo: opens the Webmoris enquiry form.</p>
    </div>
    <div class="card overflow-hidden" data-reveal-img>
      <div class="aspect-[4/3]">{% picture "cerfs-2", "Sailing boats on the east coast lagoon", "(min-width: 1024px) 33vw, 100vw", { widths: [480, 960] } %}</div>
    </div>
  </aside>
</section>
