{# Short photo header for inner pages. Expects heroPhoto, heroTitle, heroEyebrow, heroText. #}
<section class="relative isolate overflow-hidden bg-ocean-950 pt-44 pb-28 text-white">
  <div class="absolute -inset-y-20 inset-x-0 -z-10" data-parallax="0.25">
    {% picture heroPhoto, "", "100vw", { eager: true, widths: [960, 1440, 2000] } %}
  </div>
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-ocean-950/70 to-ocean-950/40"></div>
  <div class="container-x">
    <p class="eyebrow-photo hero-rise">{{ heroEyebrow }}</p>
    <h1 class="hero-rise mt-4 max-w-3xl text-5xl font-semibold sm:text-7xl [animation-delay:150ms]">{{ heroTitle }}</h1>
    {% if heroText %}<p class="hero-rise mt-5 max-w-xl text-lg text-white/85 [animation-delay:300ms]">{{ heroText }}</p>{% endif %}
  </div>
  {% set waveClass = "top-auto bottom-0 rotate-180" %}{% include "partials/waves.njk" %}
</section>
