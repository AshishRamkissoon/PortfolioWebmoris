{# Full-bleed sunset call-to-action with parallax background. #}
<section class="container-x mt-32">
  <div class="relative isolate overflow-hidden rounded-card px-8 py-24 text-center text-white sm:px-16 sm:py-32" data-reveal-img>
    <div class="absolute -inset-y-24 inset-x-0 -z-10" data-parallax="-0.2">
      {% picture "sunset", "Sunset over the sea in Mauritius", "(min-width: 1280px) 1200px, 100vw", { widths: [960, 1440, 2000] } %}
    </div>
    <div class="absolute inset-0 -z-10 bg-ocean-950/45"></div>
    <p class="eyebrow-photo">Ready when you are</p>
    <h2 class="mx-auto mt-4 max-w-3xl text-4xl font-semibold sm:text-6xl">Your Mauritius adventure starts here.</h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/85">Send a request in two minutes — we reply within a few hours.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/tours/" class="btn btn-coral px-8 py-4 text-base" data-magnetic>Find your tour</a>
      <a href="/contact/" class="btn btn-light px-8 py-4 text-base" data-magnetic>Ask a question</a>
    </div>
  </div>
</section>
