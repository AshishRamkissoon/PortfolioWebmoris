{
  "name": "island-explorer-demo",
  "private": true,
  "description": "Webmoris ready-made website demo: Island Explorer (Mauritius tours). Fictional business.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/main.css --minify",
    "build:js": "esbuild src/assets/js/main.js --bundle --format=esm --splitting --minify --outdir=_site/assets/js",
    "build:fonts": "esbuild src/assets/css/fonts.css --bundle --minify --loader:.woff2=file --loader:.woff=file --asset-names=fonts/[name] --outdir=_site/assets",
    "build:html": "eleventy",
    "build:map": "node scripts/build-map.mjs",
    "build": "npm run build:html && npm run build:fonts && npm run build:css && npm run build:js",
    "serve": "eleventy --serve --port=5002"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^6.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.3"
  }
}
