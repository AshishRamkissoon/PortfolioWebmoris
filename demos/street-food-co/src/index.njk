---
layout: layouts/base.njk
section: home
preload: { key: "hero", sizes: "(min-width: 1024px) 50vw, 100vw", widths: [480, 760, 1080, 1440] }
---
{% from "partials/icon.njk" import icon %}

{# ---------- Hero: loud headline, the truck in a tilted frame with stickers, today's spot ---------- #}
<section class="relative overflow-hidden border-b-[3px] border-ink-900 bg-sun-400" data-hero>
  <div class="pointer-events-none absolute -top-24 -right-24 size-96 rounded-full bg-pink-400/40 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative grid items-center gap-10 py-12 lg:grid-cols-[1.1fr_1fr] lg:py-20" data-hero-content>
    <div>
      <p class="hero-rise eyebrow">Mauritian street food on wheels</p>
      <h1 class="hero-rise mt-5 text-6xl [animation-delay:80ms] sm:text-7xl lg:text-8xl">Hot, fast <span class="text-pop">&amp; island-made.</span></h1>
      <p class="hero-rise lead mt-5 max-w-lg [animation-delay:160ms]">Farata wraps, mine frire and gateaux piments from our yellow truck. Order ahead on your phone and skip the queue.</p>
      <div class="hero-rise mt-7 flex flex-wrap gap-3 [animation-delay:240ms]">
        <a href="/order/" class="btn btn-primary px-7 py-3.5 text-lg" data-magnetic>{{ icon("bag", "size-5") }} Order ahead</a>
        <a href="/menu/" class="btn btn-white px-7 py-3.5 text-lg">See the menu</a>
      </div>
      <a href="#where" class="hero-rise mt-7 inline-flex items-center gap-3 rounded-2xl border-[3px] border-ink-900 bg-white px-4 py-3 font-bold shadow-[4px_4px_0_var(--color-ink-900)] [animation-delay:320ms]">
        <span class="relative grid size-3 place-items-center"><span class="absolute size-3 rounded-full bg-lime-400 motion-safe:animate-ping-slow"></span><span class="size-3 rounded-full bg-lime-600"></span></span>
        <span><span class="text-xs tracking-wide text-ink-500 uppercase">Today we're at</span><span class="block" data-today-place>see this week's spots</span></span>
        {{ icon("arrow", "size-5") }}
      </a>
    </div>

    <div class="hero-rise relative mx-auto w-full max-w-lg [animation-delay:120ms]">
      <div class="relative aspect-[4/5] rotate-2 overflow-hidden rounded-[2rem] border-[3px] border-ink-900 shadow-[10px_10px_0_var(--color-ink-900)]" data-hero-media>
        <div class="absolute inset-0" data-hero-dolly>{% picture "hero", "A bright green food truck serving customers at night", "(min-width: 1024px) 50vw, 100vw", { widths: [480, 760, 1080, 1440], eager: true } %}</div>
      </div>
      {# Stickers #}
      <span class="absolute -top-5 -left-4 grid size-28 -rotate-12 place-items-center rounded-full border-[3px] border-ink-900 bg-pink-500 text-center font-display text-lg leading-none text-white shadow-[4px_4px_0_var(--color-ink-900)] motion-safe:animate-wiggle" aria-hidden="true">From<br>Rs 60!</span>
      <span class="absolute -right-3 bottom-10 -rotate-6 rounded-2xl border-[3px] border-ink-900 bg-lime-400 px-4 py-2 font-display text-xl shadow-[4px_4px_0_var(--color-ink-900)] motion-safe:animate-float" aria-hidden="true">No queue 🙌</span>
      <svg class="absolute -bottom-8 -left-6 size-28 motion-safe:animate-spin-slow" viewBox="0 0 120 120" aria-hidden="true">
        <defs><path id="badge" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1 -88 0"/></defs>
        <circle cx="60" cy="60" r="56" fill="#1c1a18"/>
        <text class="fill-sun-300 text-[11px] font-extrabold uppercase"><textPath href="#badge" textLength="272" lengthAdjust="spacing">Made fresh · Order ahead · Made fresh ·</textPath></text>
      </svg>
    </div>
  </div>
</section>

{# ---------- Marquee ---------- #}
<section class="overflow-hidden border-b-[3px] border-ink-900 bg-pink-500 py-4 text-white" aria-label="On the menu">
  <div class="flex w-max motion-safe:animate-marquee">
    {% for copy in [1, 2] %}
      <p class="flex shrink-0 items-center font-display text-3xl whitespace-nowrap sm:text-4xl" {% if copy == 2 %}aria-hidden="true"{% endif %}>
        {% for word in site.marquee %}<span class="px-5">{{ word }}</span><span class="text-sun-300" aria-hidden="true">✺</span>{% endfor %}
      </p>
    {% endfor %}
  </div>
</section>

{# ---------- Best sellers ---------- #}
<section class="container-x py-20 sm:py-24" aria-labelledby="best-title">
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="eyebrow">Best sellers</p>
      <h2 id="best-title" class="section-title" data-split>What everyone <span class="text-pop">orders</span></h2>
    </div>
    <a href="/menu/" class="btn btn-white self-start sm:self-auto">Full menu {{ icon("arrow", "size-4") }}</a>
  </div>
  <div class="mt-10 grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
    {% asyncEach dish in menu.items | best | limit(6) %}
      <div data-reveal>{% include "partials/dish-card.njk" %}</div>
    {% endeach %}
  </div>
</section>

{# ---------- How it works ---------- #}
<section id="how" class="border-y-[3px] border-ink-900 bg-ink-900 py-20 text-white sm:py-24" aria-labelledby="how-title">
  <div class="container-x">
    <p class="eyebrow bg-sun-400 text-ink-900">How it works</p>
    <h2 id="how-title" class="section-title" data-split>Order in a minute, <span class="text-pop">eat in fifteen</span></h2>
    <ol class="mt-12 grid gap-7 md:grid-cols-3">
      {% for step in site.steps %}
        <li class="relative rounded-card border-[3px] border-white bg-white/5 p-7 {% if loop.index == 2 %}md:translate-y-6{% endif %}" data-reveal>
          <span class="absolute -top-5 -left-3 grid size-12 -rotate-6 place-items-center rounded-full border-[3px] border-ink-900 bg-sun-400 font-display text-2xl text-ink-900">{{ loop.index }}</span>
          <span class="text-sun-300">{{ icon(step.icon, "size-9") }}</span>
          <h3 class="mt-4 text-3xl">{{ step.title }}</h3>
          <p class="mt-2 text-white/75">{{ step.text }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ---------- Where's the truck ---------- #}
<section id="where" class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.1fr] lg:items-center" aria-labelledby="where-title">
  <figure class="relative mx-auto aspect-[832/1000] w-full max-w-md overflow-hidden rounded-[2rem] border-[3px] border-ink-900 bg-[#cfe6ec] shadow-[8px_8px_0_var(--color-ink-900)]" data-map>
    <img src="/img/map/mauritius.svg" alt="" width="832" height="1000" loading="lazy" decoding="async" class="absolute inset-0 size-full">
    {% for stop in site.schedule %}
      {% set p = stop | mapPos %}
      <span class="group/pin absolute -translate-x-1/2 -translate-y-full [&.is-today]:z-20" style="left: {{ p.left }}%; top: {{ p.top }}%" data-day="{{ stop.day }}" data-pin>
        <span class="block rounded-full border-2 border-ink-900 bg-white px-2 py-0.5 text-[11px] font-extrabold whitespace-nowrap shadow-[2px_2px_0_var(--color-ink-900)] group-[.is-today]/pin:scale-125 group-[.is-today]/pin:bg-pink-500 group-[.is-today]/pin:text-white">{{ stop.name | truncate(3, true, "") }}</span>
        <span class="mx-auto block h-2 w-0.5 bg-ink-900"></span>
      </span>
    {% endfor %}
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="absolute right-3 bottom-3 rounded bg-white/80 px-1.5 py-0.5 text-[10px] text-ink-500">© OpenStreetMap</a>
    <figcaption class="sr-only">Map of Mauritius with the truck's spot for each day of the week.</figcaption>
  </figure>
  <div>
    <p class="eyebrow">Find the truck</p>
    <h2 id="where-title" class="section-title" data-split>Where we park <span class="text-pop">this week</span></h2>
    <ul class="mt-8 space-y-2">
      {% for stop in site.schedule %}
        <li class="flex items-center justify-between gap-4 rounded-2xl border-[3px] border-ink-900 bg-white px-4 py-3 transition [&.is-today]:-rotate-1 [&.is-today]:bg-sun-400 [&.is-today]:shadow-[4px_4px_0_var(--color-ink-900)]" data-day="{{ stop.day }}" data-place="{{ stop.place }}">
          <span><span class="font-display text-xl">{{ stop.name }}</span> <span class="sticker ml-1 bg-pink-500 text-white" data-today-badge hidden>Today</span><span class="block text-sm text-ink-700">{{ stop.place }}</span></span>
          <span class="text-sm font-extrabold whitespace-nowrap">{{ stop.time }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------- Events ---------- #}
<section id="events" class="border-y-[3px] border-ink-900 bg-lime-400" aria-labelledby="events-title">
  <div class="container-x grid items-center gap-10 py-20 sm:py-24 lg:grid-cols-2">
    <div class="relative aspect-[4/3] -rotate-2 overflow-hidden rounded-[2rem] border-[3px] border-ink-900 shadow-[8px_8px_0_var(--color-ink-900)]" data-reveal>
      <div class="absolute inset-0" data-zoom>{% picture "events", "A crowd queuing at food trucks at an outdoor event", "(min-width: 1024px) 50vw, 100vw", { widths: [480, 960, 1440] } %}</div>
    </div>
    <div>
      <p class="eyebrow">Events &amp; parties</p>
      <h2 id="events-title" class="section-title" data-split>Bring the truck <span class="text-pop">to your party</span></h2>
      <p class="lead mt-4">Weddings, office lunches, birthdays and festivals, from 30 to 500 guests. You choose the menu, we bring the truck and the music.</p>
      {# On a client's live site this opens their WhatsApp chat; in the demo it leads to the Webmoris enquiry form. #}
      <a href="{{ site.agencyUrl }}/en/contact/ready-made/{{ site.templateSlug }}/" target="_blank" rel="noopener noreferrer" class="btn btn-dark mt-7 px-7 py-3.5">Ask on WhatsApp ↗</a>
    </div>
  </div>
</section>

{# ---------- FAQ ---------- #}
<section class="container-x grid gap-12 py-20 sm:py-24 lg:grid-cols-[1fr_1.5fr]" aria-labelledby="faq-title">
  <div>
    <p class="eyebrow">Questions</p>
    <h2 id="faq-title" class="section-title" data-split>Good to <span class="text-pop">know</span></h2>
  </div>
  <div class="space-y-3">
    {% for faq in site.faqs %}
      <details class="group rounded-2xl border-[3px] border-ink-900 bg-white px-5 shadow-[4px_4px_0_var(--color-ink-900)]" {% if loop.first %}open{% endif %}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-extrabold [&::-webkit-details-marker]:hidden">
          {{ faq.q }}
          <span class="grid size-8 shrink-0 place-items-center rounded-full border-2 border-ink-900 bg-sun-400 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="pb-4 text-ink-700">{{ faq.a }}</p>
      </details>
    {% endfor %}
  </div>
</section>

{# ---------- Call to action ---------- #}
<section class="container-x pb-20 sm:pb-24">
  <div class="relative overflow-hidden rounded-[2rem] border-[3px] border-ink-900 bg-pink-500 px-6 py-14 text-white shadow-[10px_10px_0_var(--color-ink-900)] sm:px-14" data-reveal>
    <span class="absolute -top-6 -right-6 grid size-32 rotate-12 place-items-center rounded-full border-[3px] border-ink-900 bg-sun-400 text-center font-display text-xl leading-none text-ink-900" aria-hidden="true">Hungry?</span>
    <div class="relative max-w-2xl">
      <h2 data-tour="closing" class="text-5xl sm:text-6xl">Your lunch is 15 minutes away.</h2>
      <p class="mt-3 text-lg text-white/90">Order now, pick up at the window. Pay when you collect.</p>
      <a href="/order/" class="btn btn-yellow mt-7 px-8 py-4 text-lg" data-magnetic>{{ icon("bag", "size-5") }} Start my order</a>
    </div>
  </div>
</section>
