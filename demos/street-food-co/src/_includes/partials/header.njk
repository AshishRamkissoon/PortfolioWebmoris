{% from "partials/icon.njk" import icon %}
{% set nav = [
  { url: "/menu/", label: "Menu", key: "menu" },
  { url: "/#where", label: "Find the truck", key: "where" },
  { url: "/#how", label: "How it works", key: "how" },
  { url: "/#events", label: "Events", key: "events" }
] %}
<header class="site-header" data-header style="top: var(--demo-bar-h, 0px)">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {% for item in nav %}
        <a href="{{ item.url }}" class="nav-link" {% if section == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/order/" class="btn btn-primary hidden px-5 py-2 sm:inline-flex" data-magnetic>{{ icon("bag", "size-5") }} Order <span class="rounded-full bg-white px-2 text-xs text-ink-900" data-basket-count hidden>0</span></a>
      <button type="button" class="grid size-11 place-items-center rounded-full border-[3px] border-ink-900 bg-white md:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="sr-only">Menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t-[3px] border-ink-900 bg-sun-300 md:hidden" aria-label="Mobile" hidden>
    <div class="container-x flex flex-col py-4">
      {% for item in nav %}
        <a href="{{ item.url }}" class="border-b-2 border-ink-900/15 py-4 font-display text-3xl" data-menu-link>{{ item.label }}</a>
      {% endfor %}
      <a href="/order/" class="btn btn-primary mt-5" data-menu-link>Order now</a>
    </div>
  </nav>
</header>
