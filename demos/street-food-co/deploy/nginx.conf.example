# /etc/nginx/sites-available/street-food-co-demo — static demo, kept out of search engines.
server {
    listen 443 ssl http2;
    server_name street-food-co.demo.webmoris.example;
    root /srv/webmoris/demos/street-food-co;

    # Demo: never indexed.
    add_header X-Robots-Tag "noindex, nofollow" always;
    # Strict policy: only our own files. ('unsafe-inline' styles: positions set by the templates are inline styles.)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://webmoris.mu; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ =404;
    }
    # Responsive images have content hashes in their names: cache for a year.
    # (CSS, JS, fonts and /img/full/ are not fingerprinted, so they keep normal caching.)
    location ~* ^/img/(?!full/) {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
    error_page 404 /404.html;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml;
}
