---
layout: layouts/base.njk
section: properties
pagination:
  data: properties
  size: 1
  alias: home
permalink: "/properties/{{ home.slug }}/"
eleventyComputed:
  title: "{{ home.title }}, {{ home.place }}"
  description: "{{ home.summary }} {{ home.type | lookup(site.types) }} for sale in {{ home.place }}, Mauritius. Example listing."
  ctaHref: "#viewing"
---
{% from "partials/icon.njk" import icon %}
<section class="container-x py-8">
  <nav class="text-sm text-ink-500" aria-label="Breadcrumb"><a href="/properties/" class="hover:text-emerald-700">Properties</a> / <span class="text-ink-900">{{ home.title }}</span></nav>
  <div class="mt-4 flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
    <div>
      <p class="flex items-center gap-2 text-sm font-semibold text-emerald-700">{{ icon("pin", "size-4") }}{{ home.place }}, Mauritius · {{ home.type | lookup(site.types) }}</p>
      <h1 class="mt-2 text-4xl sm:text-5xl lg:text-6xl">{{ home.title }}</h1>
    </div>
    <p class="font-display text-4xl text-emerald-800 sm:text-5xl">{{ home.price | usd }}</p>
  </div>

  {# Gallery: one large photo and up to four more; links open the full-size photo (a viewer with JS). #}
  <div class="mt-8 grid gap-3 lg:h-[34rem] lg:grid-cols-4 lg:grid-rows-2" data-gallery>
    {% asyncEach key in home.photos | limit(5) %}
      <a href="{% photoUrl key, 1920 %}" class="group zoom-img relative block overflow-hidden rounded-2xl bg-sand-100 {% if loop.first %}aspect-[4/3] lg:col-span-2 lg:row-span-2 lg:aspect-auto{% else %}hidden aspect-[4/3] sm:block lg:aspect-auto{% endif %}" data-gallery-item data-caption="{{ home.title }}, photo {{ loop.index }}">
        {% picture key, home.title + ", photo " + loop.index, "(min-width: 1024px) 50vw, 100vw", { widths: [480, 960, 1440], eager: loop.first } %}
        {% if loop.first %}<span class="glass absolute bottom-4 left-4 px-4 py-1.5 text-sm font-bold">View {{ home.photos | length }} photo{% if home.photos.length > 1 %}s{% endif %}</span>{% endif %}
      </a>
    {% endeach %}
  </div>
</section>

<section class="container-x grid gap-10 pb-16 lg:grid-cols-[1.6fr_1fr] lg:items-start">
  <div>
    {# Key facts #}
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {% for fact in [["bed", "Bedrooms", home.beds], ["bath", "Bathrooms", home.baths], ["size", "Living area", (home.size ~ " m²") if home.size else "—"], ["land", "Plot", (home.land ~ " m²") if home.land else "—"]] %}
        <div class="rounded-2xl bg-white p-4 shadow-[0_1px_2px_rgb(20_33_29/0.06)] ring-1 ring-line">
          <span class="text-gold-500">{{ icon(fact[0], "size-5") }}</span>
          <dt class="mt-2 text-xs text-ink-500">{{ fact[1] }}</dt>
          <dd class="font-display text-2xl">{{ fact[2] or "—" }}</dd>
        </div>
      {% endfor %}
    </dl>

    <h2 class="mt-12 text-3xl">About this home</h2>
    <p class="mt-4 text-lg text-ink-700">{{ home.description }}</p>
    {% if home.international %}
      <p class="mt-5 flex items-start gap-3 rounded-2xl bg-emerald-50 p-4 text-sm text-emerald-800">{{ icon("globe", "size-5 mt-0.5") }}<span><strong>Open to international buyers.</strong> We confirm eligibility with your notary before any offer.</span></p>
    {% endif %}

    <h2 class="mt-12 text-3xl">Features</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {% for feature in home.features %}<li class="flex items-center gap-3 text-ink-700"><span class="grid size-7 place-items-center rounded-full bg-emerald-50 text-emerald-700">{{ icon("check", "size-4") }}</span>{{ feature }}</li>{% endfor %}
    </ul>

    <h2 class="mt-12 text-3xl">Location</h2>
    {% set p = home | mapPos %}
    <figure class="relative mt-5 aspect-[832/1000] max-w-md overflow-hidden rounded-[1.5rem] bg-[#cfe6ec]">
      <img src="/img/map/mauritius.svg" alt="" width="832" height="1000" loading="lazy" decoding="async" class="absolute inset-0 size-full">
      <span class="absolute" style="left: {{ p.left }}%; top: {{ p.top }}%" aria-hidden="true">
        <span class="absolute top-0 left-0 size-10 -translate-1/2 rounded-full bg-coral-500/40 motion-safe:animate-ping-slow"></span>
        <span class="absolute top-0 left-0 size-4 -translate-1/2 rounded-full border-[3px] border-white bg-coral-500 shadow-lg"></span>
      </span>
      <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="absolute right-3 bottom-3 rounded bg-white/80 px-1.5 py-0.5 text-[10px] text-ink-500">© OpenStreetMap</a>
      <figcaption class="sr-only">{{ home.place }} on the map of Mauritius.</figcaption>
    </figure>
    <p class="mt-3 text-sm text-ink-500">Approximate location. We share the exact address before a viewing.</p>

    {# Monthly payment estimate #}
    {% if home.price > 0 %}
    <form class="card mt-12 p-6 sm:p-8" data-mortgage data-price="{{ home.price }}" aria-labelledby="mortgage-title">
      <h2 id="mortgage-title" class="text-3xl">Monthly payment estimate</h2>
      <p class="mt-1 text-sm text-ink-500">A rough guide only. Banks set their own terms.</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-3">
        <label class="block"><span class="field-label">Deposit <span class="text-ink-900" data-value-for="deposit" data-unit="%">30%</span></span><input type="range" name="deposit" min="10" max="70" step="5" value="30" class="w-full accent-[#14614f]"></label>
        <label class="block"><span class="field-label">Interest rate <span class="text-ink-900" data-value-for="rate" data-unit="%">5.5%</span></span><input type="range" name="rate" min="2" max="10" step="0.5" value="5.5" class="w-full accent-[#14614f]"></label>
        <label class="block"><span class="field-label">Term <span class="text-ink-900" data-value-for="years" data-unit=" years">20 years</span></span><input type="range" name="years" min="5" max="30" step="5" value="20" class="w-full accent-[#14614f]"></label>
      </div>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-4 rounded-2xl bg-linear-to-br from-emerald-900 to-emerald-700 p-5 text-white" data-mortgage-result hidden>
        <p class="text-sm text-white/75">Loan <span class="block text-lg font-bold text-white" data-loan-out>—</span></p>
        <p class="text-right text-sm text-white/75">Estimated monthly payment<span class="block font-display text-4xl text-gold-300" data-mortgage-out>$0</span></p>
      </div>
    </form>
    {% endif %}
  </div>

  {# Viewing request: sticky on desktop #}
  <aside id="viewing" class="card scroll-mt-28 p-6 sm:p-7 lg:sticky lg:top-28">
    <p class="font-display text-3xl text-emerald-800">{{ home.price | usd }}</p>
    <p class="text-sm text-ink-500">{{ home.place }} · Example listing</p>
    <form class="mt-5 space-y-3" action="/contact/" method="post">
      <h2 class="font-body text-lg font-bold tracking-normal">Book a viewing</h2>
      <div class="grid grid-cols-2 gap-2" role="radiogroup" aria-label="Viewing type">
        <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-line p-3 text-sm font-semibold has-[:checked]:border-emerald-700 has-[:checked]:bg-emerald-50"><input type="radio" name="visit" value="in-person" class="sr-only" checked>{{ icon("home", "size-4") }} In person</label>
        <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-line p-3 text-sm font-semibold has-[:checked]:border-emerald-700 has-[:checked]:bg-emerald-50"><input type="radio" name="visit" value="video" class="sr-only">{{ icon("video", "size-4") }} By video</label>
      </div>
      <input class="field" name="name" placeholder="Full name" aria-label="Full name" required autocomplete="name">
      <input class="field" name="email" type="email" placeholder="Email" aria-label="Email" required autocomplete="email">
      <input class="field" name="phone" type="tel" placeholder="Phone / WhatsApp" aria-label="Phone or WhatsApp" autocomplete="tel">
      <input class="field" name="date" type="date" aria-label="Preferred date">
      <input type="hidden" name="property" value="{{ home.slug }}">
      <button type="submit" class="btn btn-primary w-full py-3.5 text-base" data-magnetic>Request a viewing</button>
      <p class="text-center text-xs text-ink-500">We reply within a few hours, Monday to Saturday.</p>
    </form>
  </aside>
</section>

<section class="bg-sand-100 py-16">
  <div class="container-x">
    <h2 class="text-3xl sm:text-4xl">Similar <span class="text-gold">homes</span></h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% asyncEach home in properties | similar(home) | limit(3) %}
        {% include "partials/property-card.njk" %}
      {% endeach %}
    </div>
  </div>
</section>
