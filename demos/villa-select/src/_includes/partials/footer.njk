<footer class="bg-emerald-950 text-white">
  <div class="container-x grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="text-white" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
      <p class="mt-4 max-w-xs text-sm text-white/60">{{ site.tagline }}. Guidance for international buyers, from the first viewing to the keys.</p>
    </div>
    <div>
      <h2 class="text-sm font-bold">Office</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li>{{ site.address }}</li>
        <li>Mon–Sat, 9:00–18:00</li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li>{{ site.phone }}</li>
        <li>{{ site.email }}</li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li><a href="/properties/" class="hover:text-white">Properties</a></li>
        <li><a href="/#buying" class="hover:text-white">Buying guide</a></li>
        <li><a href="/contact/" class="hover:text-white">Book a viewing</a></li>
        <li><a href="/credits/" class="hover:text-white">Photo credits</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-x py-5 text-xs text-white/50">Villa Select is a fictional agency. Listings and prices are examples. Demo website designed and built by Webmoris.</p>
  </div>
</footer>
