{% from "partials/icon.njk" import icon %}
{% set nav = [
  { url: "/properties/", label: "Properties", key: "properties" },
  { url: "/#map", label: "Map", key: "map" },
  { url: "/#areas", label: "Areas", key: "areas" },
  { url: "/#buying", label: "Buying guide", key: "buying" },
  { url: "/contact/", label: "Contact", key: "contact" }
] %}
{# Over the home hero the header starts transparent with white text, and turns solid on scroll. #}
<header class="site-header {% if heroHeader %}text-white{% else %}is-solid{% endif %}" data-header {% if heroHeader %}data-hero-header{% endif %} style="top: var(--demo-bar-h, 0px)">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {% for item in nav %}
        <a href="{{ item.url }}" class="nav-link" {% if section == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="flex items-center gap-3">
      <a href="tel:{{ site.phone | replace(' ', '') }}" class="hidden items-center gap-2 text-sm font-semibold opacity-85 xl:flex">{{ icon("phone", "size-4") }}{{ site.phone }}</a>
      <a href="/contact/" class="btn btn-primary hidden sm:inline-flex">Book a viewing</a>
      <button type="button" class="grid size-11 place-items-center rounded-full border border-current/25 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="sr-only">Menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t border-line bg-white text-ink-900 lg:hidden" aria-label="Mobile" hidden>
    <div class="container-x flex flex-col py-4">
      {% for item in nav %}
        <a href="{{ item.url }}" class="border-b border-line py-4 font-display text-2xl" data-menu-link>{{ item.label }}</a>
      {% endfor %}
      <a href="/contact/" class="btn btn-primary mt-5" data-menu-link>Book a viewing</a>
    </div>
  </nav>
</header>
