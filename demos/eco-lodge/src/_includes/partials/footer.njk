<footer class="bg-forest-950 text-white">
  <div class="container-x grid gap-10 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="text-white" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
      <p class="mt-4 max-w-xs text-sm text-white/60">{{ site.tagline }}, next to the Black River Gorges. Book direct for the best price.</p>
    </div>
    <div>
      <h2 class="text-sm font-bold">The lodge</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li>{{ site.address }}</li>
        <li>Reception 7:00–22:00</li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li>{{ site.phone }}</li>
        <li>{{ site.email }}</li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm text-white/60">
        <li><a href="/rooms/" class="hover:text-white">Rooms</a></li>
        <li><a href="/#experiences" class="hover:text-white">Experiences</a></li>
        <li><a href="/book/" class="hover:text-white">Book direct</a></li>
        <li><a href="/credits/" class="hover:text-white">Photo credits</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-x py-5 text-xs text-white/50">Eco Lodge is a fictional lodge. Rooms and prices are examples. Demo website designed and built by Webmoris.</p>
  </div>
</footer>
