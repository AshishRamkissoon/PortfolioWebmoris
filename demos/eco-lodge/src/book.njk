---
layout: layouts/base.njk
title: Check availability
section: book
description: Check availability and book direct at Eco Lodge, Chamarel. 10% off, breakfast included and free cancellation up to 7 days.
ctaHref: "#details"
ctaLabel: "Request booking"
---
{% from "partials/icon.njk" import icon %}
<section class="relative overflow-hidden bg-linear-to-br from-forest-950 via-forest-900 to-forest-700 text-white">
  <div class="absolute -top-24 -right-24 size-96 rounded-full bg-honey-400/25 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-10 sm:py-14">
    <p class="hero-rise eyebrow text-honey-400">Book direct</p>
    <h1 class="hero-rise mt-3 text-5xl [animation-delay:80ms] sm:text-6xl">Choose your <span class="text-warm-light">nights</span></h1>
    <p class="hero-rise mt-3 max-w-2xl text-lg text-white/80 [animation-delay:160ms]">10% off the booking-site price, breakfast included. No payment now: we confirm within a few hours.</p>
  </div>
</section>

<form class="container-x grid gap-10 pt-10 pb-20 lg:grid-cols-[1.6fr_1fr] lg:items-start" action="/book/" method="post" data-booking data-discount="{{ site.directDiscount }}">
  <div class="space-y-6">
    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">Room</legend>
      <h2 class="flex items-center gap-3 font-body text-xl font-bold tracking-normal"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-terra-500 to-honey-400 text-sm text-white">1</span>Choose a room</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {% asyncEach room in rooms %}
          <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-line p-3 transition hover:border-ink-300 has-[:checked]:border-forest-700 has-[:checked]:bg-moss-50 has-[:checked]:ring-2 has-[:checked]:ring-moss-100">
            <input type="radio" name="room" value="{{ room.slug }}" class="sr-only" data-seed="{{ room.seed }}" data-price="{{ room.price }}" data-name="{{ room.name }}" {% if loop.first %}checked{% endif %}>
            <span class="block h-14 w-20 shrink-0 overflow-hidden rounded-lg">{% picture room.photos[0], "", "80px", { widths: [480] } %}</span>
            <span class="min-w-0 flex-1"><span class="block font-bold">{{ room.name }}</span><span class="block text-xs text-ink-500">Up to {{ room.guests }} · {{ room.beds }}</span></span>
            <span class="text-sm font-bold text-forest-700">{{ room.price | mur }}</span>
          </label>
        {% endeach %}
      </div>
    </fieldset>

    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">Dates</legend>
      <h2 class="flex items-center gap-3 font-body text-xl font-bold tracking-normal"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-terra-500 to-honey-400 text-sm text-white">2</span>Pick your dates</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        <label><span class="field-label">Check-in</span><input class="field min-w-0" type="date" name="checkin" required></label>
        <label><span class="field-label">Check-out</span><input class="field min-w-0" type="date" name="checkout" required></label>
        <label><span class="field-label">Guests</span><select class="field" name="guests">{% for n in range(1, 6) %}<option {% if n == 2 %}selected{% endif %}>{{ n }}</option>{% endfor %}</select></label>
      </div>
      <div class="mt-5">
        {% set attrs = "data-booking-calendar" %}
        {% include "partials/calendar.njk" %}
      </div>
    </fieldset>

    <fieldset id="details" class="card scroll-mt-28 p-6 sm:p-7">
      <legend class="sr-only">Your details</legend>
      <h2 class="flex items-center gap-3 font-body text-xl font-bold tracking-normal"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-terra-500 to-honey-400 text-sm text-white">3</span>Your details</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label><span class="field-label">Full name</span><input class="field" name="name" required autocomplete="name"></label>
        <label><span class="field-label">Email</span><input class="field" name="email" type="email" required autocomplete="email"></label>
        <label><span class="field-label">Phone / WhatsApp</span><input class="field" name="phone" type="tel" autocomplete="tel"></label>
        <label><span class="field-label">Arrival time (optional)</span><input class="field" name="arrival" type="time"></label>
        <label class="sm:col-span-2"><span class="field-label">Special requests (optional)</span><textarea class="field" name="notes" rows="3" placeholder="Airport transfer, a cot, dietary needs, a special occasion…"></textarea></label>
      </div>
    </fieldset>
  </div>

  <aside class="lg:sticky lg:top-28">
    <div class="card p-7" data-summary hidden aria-live="polite">
      <h2 class="font-body text-xl font-bold tracking-normal">Your stay</h2>
      <p class="mt-3 font-display text-3xl" data-out="room">—</p>
      <p class="text-sm text-ink-500" data-out="dates">Choose your dates</p>
      <dl class="mt-5 space-y-3 border-t border-line pt-5 text-sm">
        <div class="flex justify-between"><dt class="text-ink-500">Nights</dt><dd class="font-semibold" data-out="nights">0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Direct rate per night</dt><dd class="font-semibold" data-out="rate">Rs 0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Breakfast</dt><dd class="font-semibold text-forest-700">Included</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Airport transfer</dt><dd class="font-semibold text-forest-700" data-out="transfer">From 3 nights</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">On booking sites</dt><dd class="font-semibold text-ink-500 line-through" data-out="ota">—</dd></div>
      </dl>
      <div class="mt-5 rounded-2xl bg-linear-to-br from-forest-800 to-forest-500 p-4 text-white">
        <div class="flex items-end justify-between"><p class="font-bold">Total</p><p class="text-4xl font-bold tracking-tight" data-out="total">Rs 0</p></div>
        <p class="mt-2 flex items-center justify-between rounded-xl bg-white/15 px-3 py-2 text-sm font-bold">You save by booking direct <span class="text-honey-300" data-out="saving">Rs 0</span></p>
      </div>
      <button type="submit" class="btn btn-primary mt-5 w-full py-3.5 text-base" data-magnetic>Request booking</button>
      <ul class="mt-4 space-y-1.5 text-xs text-ink-500">
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-forest-500") }}No payment now</li>
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-forest-500") }}Free cancellation up to 7 days</li>
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-forest-500") }}Example prices (demo)</li>
      </ul>
    </div>

    {# Without JS: the rates, and a plain submit button #}
    <div class="card p-7" data-summary-fallback>
      <h2 class="font-body text-xl font-bold tracking-normal">Rates per night, direct</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>{% for room in rooms %}<tr class="border-b border-line"><td class="py-2">{{ room.name }}</td><td class="py-2 text-right font-bold">{{ room.price | mur }}</td></tr>{% endfor %}</tbody>
      </table>
      <button type="submit" class="btn btn-primary mt-5 w-full">Request booking</button>
    </div>
  </aside>
</form>
