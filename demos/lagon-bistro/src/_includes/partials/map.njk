{# Location map: OpenStreetMap base map of Mauritius with a pin, and a click-to-load Google Map. #}
{% set pin = site.location | mapPos %}
{% set coords = site.location.lat ~ "," ~ site.location.lng %}
<figure class="relative overflow-hidden rounded-card bg-[#cfe6ec]" data-reveal>
  <div class="relative mx-auto aspect-[832/1000] w-full max-w-xl">
    <img src="/img/map/mauritius.svg" alt="" width="832" height="1000" loading="lazy" decoding="async" class="absolute inset-0 size-full">
    <div class="pointer-events-none absolute z-20" style="left: {{ pin.left }}%; top: {{ pin.top }}%">
      <span class="absolute top-0 left-0 hidden size-10 -translate-1/2 rounded-full bg-sun-500/40 motion-safe:block motion-safe:animate-ping"></span>
      <svg class="absolute bottom-0 left-0 h-11 w-9 -translate-x-1/2 drop-shadow-lg" viewBox="0 0 32 40" aria-hidden="true">
        <path d="M16 39s13-13.4 13-23.5a13 13 0 0 0-26 0C3 25.6 16 39 16 39z" fill="#ff7a3d" stroke="#fff" stroke-width="2"/>
        <circle cx="16" cy="15.5" r="5" fill="#fff"/>
      </svg>
      <span class="absolute bottom-13 -left-4 rounded-full bg-night-950 px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-cream-50 shadow-xl">{{ site.name }}</span>
    </div>
    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer" class="absolute right-3 bottom-3 rounded bg-white/70 px-1.5 py-0.5 text-[10px] text-ink-600">© OpenStreetMap</a>
    <a href="https://www.google.com/maps/search/?api=1&amp;query={{ coords }}" target="_blank" rel="noopener noreferrer"
       class="btn absolute top-4 left-4 z-30 bg-night-950 px-4 py-2.5 text-xs text-cream-50 shadow-lg hover:bg-sun-500 hover:text-night-950"
       data-map-embed="https://www.google.com/maps?q={{ coords }}&amp;z=15&amp;hl=en&amp;output=embed" data-map-title="Google Map of {{ site.location.name }}">
      <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2zM9 4v14M15 6v14"/></svg>
      <span data-map-label>Interactive map</span>
    </a>
  </div>
  <figcaption class="sr-only">Map of Mauritius showing {{ site.name }} on {{ site.location.name }}, on the west coast.</figcaption>
</figure>
