{% set nav = [
  { url: "/menu/", label: "Menu", key: "menu" },
  { url: "/#day", label: "Our day", key: "day" },
  { url: "/#events", label: "Events", key: "events" },
  { url: "/#visit", label: "Visit", key: "visit" }
] %}
<header class="site-header" data-header style="top: var(--demo-bar-h, 0px)">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="text-cream-50" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
    <nav class="hidden items-center gap-9 md:flex" aria-label="Main">
      {% for item in nav %}
        <a href="{{ item.url }}" class="nav-link" {% if section == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/reserve/" class="btn btn-sun hidden px-5 py-2.5 sm:inline-flex" data-magnetic>Book a table</a>
      <button type="button" class="grid size-11 place-items-center rounded-full border border-cream-100/20 md:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="sr-only">Menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t border-cream-100/10 bg-night-950/95 backdrop-blur-xl md:hidden" aria-label="Mobile" hidden>
    <div class="container-x flex flex-col py-6">
      {% for item in nav %}
        <a href="{{ item.url }}" class="border-b border-cream-100/10 py-4 text-3xl font-semibold" data-menu-link>{{ item.label }}</a>
      {% endfor %}
      <a href="/reserve/" class="btn btn-sun mt-6" data-menu-link>Book a table</a>
    </div>
  </nav>
</header>
