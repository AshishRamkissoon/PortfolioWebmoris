<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }} — demo</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#090c11">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script src="/boot.js"></script>
  {# Preload the headline font so the big hero text doesn't reflow when it arrives (layout shift). #}
  <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% if preload %}{% preloadImage preload.key, preload.sizes, preload.widths %}{% endif %}
  <link rel="stylesheet" href="/assets/fonts.css">
  <link rel="stylesheet" href="/assets/main.css">
  <script type="module" src="/assets/js/main.js"></script>
</head>
<body class="{{ bodyClass }}">
  {# First in <body> and synchronous: the demo bar exists before first paint (no layout shift). #}
  <script src="/demo-kit.js"
          data-template="{{ site.templateSlug }}" data-agency="{{ site.agencyUrl }}" data-lang="{{ site.lang }}"></script>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-16 focus:left-4 focus:z-50 focus:rounded-full focus:bg-sun-500 focus:px-4 focus:py-2 focus:text-night-950">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <div class="grain" aria-hidden="true"></div>
</body>
</html>
