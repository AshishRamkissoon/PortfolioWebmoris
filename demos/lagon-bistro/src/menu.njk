---
layout: layouts/base.njk
title: Menu
section: menu
preload: { key: "claypot", sizes: "(min-width: 1024px) 40vw, 100vw", widths: [480, 960, 1440] }
description: The Lagon Bistro menu — Mauritian street food, seafood from the grill, Creole curries, desserts and rum cocktails.
---
<section class="relative isolate overflow-hidden pt-40 pb-20 sm:pt-48">
  <div class="container-x grid items-end gap-12 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="hero-rise eyebrow">Lunch · Sunset · Dinner</p>
      <h1 class="hero-rise mt-6 text-[clamp(4rem,9vw,8.5rem)] leading-[0.9] font-extrabold whitespace-nowrap [animation-delay:100ms]">The <span class="serif-i text-sunset">menu.</span></h1>
      <p class="hero-rise mt-8 max-w-lg text-lg text-cream-200 [animation-delay:220ms]">Fish from the morning boats, slow-cooked Creole pots and the street food every Mauritian grew up on. Prices in rupees, VAT included.</p>
    </div>
    <div class="hero-rise relative h-80 overflow-hidden rounded-card [animation-delay:150ms] lg:h-[420px]">
      <div class="absolute -inset-y-16 inset-x-0" data-parallax="0.2">{% picture "claypot", "A fish curry with curry leaves in a dark clay pot", "(min-width: 1024px) 40vw, 100vw", { eager: true, widths: [480, 960, 1440] } %}</div>
    </div>
  </div>
</section>

<div class="bg-cream-100 pb-28 text-ink-900">
  <nav class="sticky z-30 border-b border-ink-900/10 bg-cream-100/90 backdrop-blur-lg" style="top: calc(var(--demo-bar-h, 0px) + 5rem)" aria-label="Menu sections" data-menu-filters>
    <div class="container-x flex gap-2 overflow-x-auto py-4 [scrollbar-width:none]">
      <a href="#top-of-menu" class="filter-btn" data-filter="all" aria-pressed="true">All</a>
      {% for section in menu.sections %}<a href="#{{ section.slug }}" class="filter-btn" data-filter="{{ section.slug }}" aria-pressed="false">{{ section.short }}</a>{% endfor %}
    </div>
  </nav>

  <div id="top-of-menu" class="container-x pt-16" data-menu-list>
    {% for section in menu.sections %}
      <section id="{{ section.slug }}" class="scroll-mt-48 border-b border-ink-900/10 py-16 last:border-b-0" data-menu-section="{{ section.slug }}" aria-labelledby="{{ section.slug }}-title">
        <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
          <div class="lg:sticky lg:top-56 lg:self-start">
            <p class="text-sm font-semibold text-sun-600 tabular-nums">0{{ loop.index }}</p>
            <h2 id="{{ section.slug }}-title" class="mt-3 text-4xl leading-none font-extrabold sm:text-5xl" data-split>{{ section.name }}</h2>
            <p class="mt-4 max-w-xs text-ink-600">{{ section.intro }}</p>
          </div>
          <ul class="divide-y divide-ink-900/10">
            {% asyncEach item in menu.items | bySection(section.slug) %}
              <li class="group py-6" {% if item.photo %}data-preview="{% photoUrl item.photo, 720 %}" data-cursor="Taste"{% endif %} data-reveal>
                <div class="flex items-baseline gap-4">
                  <h3 class="text-xl font-bold transition-colors group-hover:text-sun-600 sm:text-2xl">{{ item.name }}</h3>
                  <span class="flex-1 translate-y-[-0.3em] border-b-2 border-dotted border-ink-900/20" aria-hidden="true"></span>
                  <p class="text-lg font-semibold whitespace-nowrap tabular-nums">{{ item.price | money }}</p>
                </div>
                <p class="mt-2 max-w-xl text-ink-600">{{ item.desc }}</p>
                {% if item.tags.length %}
                  <p class="mt-3 flex flex-wrap gap-2">
                    {% for tag in item.tags %}<span class="chip {% if tag == 'spicy' %}text-sun-600{% elif tag == 'v' %}text-[#3f7d3a]{% else %}text-ink-600{% endif %}">{% if tag == 'spicy' %}🌶 {% endif %}{{ menu.tags[tag] }}</span>{% endfor %}
                  </p>
                {% endif %}
              </li>
            {% endeach %}
          </ul>
        </div>
      </section>
    {% endfor %}
    <p class="mt-6 rounded-3xl bg-ink-900/5 p-6 text-sm text-ink-600">Please tell us about any allergies when you order. Seasonal dishes depend on the morning catch. This menu is part of a demo website: dishes and prices are examples.</p>
  </div>
</div>

<section class="relative overflow-hidden py-28 text-center">
  <h2 class="text-5xl font-extrabold sm:text-7xl" data-split>Hungry <span class="serif-i text-sun-300">yet?</span></h2>
  <a href="/reserve/" class="btn btn-sun mt-10 px-9 py-4 text-base" data-magnetic>Book a table</a>
</section>
