{% elif name == "pin" %}<path d="M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/>
{% elif name == "clock" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elif name == "seat" %}<path d="M7 20v-3M17 20v-3M6 17h12M8 17l-1-9a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2l1 9"/>
{% elif name == "bag" %}<rect x="5" y="7" width="14" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
{% elif name == "gear" %}<circle cx="6" cy="6" r="2"/><circle cx="12" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6 8v8M12 8v8M18 6v4a2 2 0 0 1-2 2H6"/>
{% elif name == "snow" %}<path d="M12 3v18M4 7.5l16 9M20 7.5l-16 9"/>
{% elif name == "door" %}<path d="M5 20V5a1 1 0 0 1 1-1h9l4 4v12zM15 13h1"/>
{% elif name == "check" %}<path d="M5 12l5 5 9-10"/>
{% elif name == "phone" %}<path d="M5 4h4l2 5-3 2a11 11 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
{% elif name == "arrow" %}<path d="M5 12h14M13 6l6 6-6 6"/>
{% else %}<path d="M5 17h14l-1.5-5.5A2 2 0 0 0 15.6 10H8.4a2 2 0 0 0-1.9 1.5zM5 17v2M19 17v2M7.5 14h.01M16.5 14h.01"/>{% endif %}
</svg>{% endmacro %}
