{# Line icons: {% from "partials/icon.njk" import icon %} then {{ icon("shield", "size-5") }} #}
{% macro icon(name, size) %}<svg class="{{ size or 'size-6' }} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == "shield" %}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6zM9 12l2 2 4-4"/>
