<footer class="relative overflow-hidden border-t border-kerb pt-20">
  <div class="container-x grid gap-12 pb-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="text-road" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
      <p class="mt-5 max-w-xs text-dust">{{ site.tagline }}. The whole island, one key.</p>
    </div>
    <div>
      <h2 class="label-km">Desk</h2>
      <ul class="mt-5 space-y-2 text-road/85">
        <li>{{ site.address }}</li>
        <li class="figure text-sm">Open 24/7 for arrivals</li>
      </ul>
    </div>
    <div>
      <h2 class="label-km">Call</h2>
      <ul class="mt-5 space-y-2 text-road/85">
        <li class="figure text-sm">{{ site.phone }}</li>
        <li class="figure text-sm">{{ site.email }}</li>
      </ul>
    </div>
    <div>
      <h2 class="label-km">Explore</h2>
      <ul class="mt-5 space-y-2 text-road/85">
        <li><a href="/fleet/" class="hover:text-sodium">Fleet</a></li>
        <li><a href="/book/" class="hover:text-sodium">Book a car</a></li>
        <li><a href="/#terms" class="hover:text-sodium">Terms &amp; FAQ</a></li>
        <li><a href="/credits/" class="hover:text-sodium">Photo credits</a></li>
      </ul>
    </div>
  </div>
  <div class="lane-x h-0.5 opacity-40" aria-hidden="true"></div>
  <p class="container-x py-6 font-mono text-[11px] tracking-[0.14em] text-dust uppercase">Drive Moris is a fictional company. Example prices. Demo website designed and built by Webmoris.</p>
</footer>
