{% set nav = [
  { url: "/fleet/", label: "Fleet", key: "fleet" },
  { url: "/#coast", label: "The coast", key: "coast" },
  { url: "/#drives", label: "Drives", key: "drives" },
  { url: "/#terms", label: "Terms", key: "terms" }
] %}
<header class="site-header" data-header style="top: var(--demo-bar-h, 0px)">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href="/" class="text-road" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
    <nav class="hidden items-center gap-10 md:flex" aria-label="Main">
      {% for item in nav %}
        <a href="{{ item.url }}" class="nav-link" {% if section == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/book/" class="btn btn-sodium hidden px-5 py-3 sm:inline-flex" {% if section == "book" %}aria-current="page"{% endif %} data-magnetic>Book a car</a>
      <button type="button" class="grid size-11 place-items-center shadow-[inset_0_0_0_1px_var(--color-kerb)] md:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="sr-only">Menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t border-kerb bg-tarmac md:hidden" aria-label="Mobile" hidden>
    <div class="container-x flex flex-col py-6">
      {% for item in nav %}
        <a href="{{ item.url }}" class="border-b border-kerb py-4 font-display text-4xl font-black uppercase" data-menu-link>{{ item.label }}</a>
      {% endfor %}
      <a href="/book/" class="btn btn-sodium mt-6" data-menu-link>Book a car</a>
    </div>
  </nav>
</header>
