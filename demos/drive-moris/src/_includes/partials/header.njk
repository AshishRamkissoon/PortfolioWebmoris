{% from "partials/icon.njk" import icon %}
{% set nav = [
  { url: "/fleet/", label: "Our cars", key: "fleet" },
  { url: "/#how", label: "How it works", key: "how" },
  { url: "/#trips", label: "Day trips", key: "trips" },
  { url: "/#faq", label: "FAQ", key: "faq" }
] %}
<header class="site-header" data-header style="top: var(--demo-bar-h, 0px)">
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-6">
    <a href="/" class="text-ink-900" aria-label="{{ site.name }} home">{% include "partials/logo.njk" %}</a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {% for item in nav %}
        <a href="{{ item.url }}" class="nav-link" {% if section == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    <div class="flex items-center gap-3">
      <a href="tel:{{ site.phone | replace(' ', '') }}" class="hidden items-center gap-2 text-sm font-semibold text-ink-700 lg:flex">{{ icon("phone", "size-4") }}{{ site.phone }}</a>
      <a href="/book/" class="btn btn-primary hidden sm:inline-flex">Book a car</a>
      <button type="button" class="grid size-11 place-items-center rounded-full border border-line md:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span class="sr-only">Menu</span>
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="border-t border-line bg-white md:hidden" aria-label="Mobile" hidden>
    <div class="container-x flex flex-col py-4">
      {% for item in nav %}
        <a href="{{ item.url }}" class="border-b border-line py-4 text-lg font-bold" data-menu-link>{{ item.label }}</a>
      {% endfor %}
      <a href="/book/" class="btn btn-primary mt-5" data-menu-link>Book a car</a>
    </div>
  </nav>
</header>
