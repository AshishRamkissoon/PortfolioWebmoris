{# Static night road: the hero for phones, reduced motion and browsers without WebGL. Same scene as the shader. #}
<svg class="absolute inset-0 size-full" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="road-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#08090c"/><stop offset=".72" stop-color="#141a22"/><stop offset="1" stop-color="#3a2a14"/>
    </linearGradient>
    <radialGradient id="road-haze" cx=".5" cy="1" r=".6"><stop offset="0" stop-color="#ffae1a" stop-opacity=".35"/><stop offset="1" stop-color="#ffae1a" stop-opacity="0"/></radialGradient>
    <linearGradient id="road-tarmac" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1c1a17"/><stop offset="1" stop-color="#0e0f10"/></linearGradient>
    <radialGradient id="road-beam" cx=".5" cy="1" r=".55"><stop offset="0" stop-color="#fff1d6" stop-opacity=".28"/><stop offset="1" stop-color="#fff1d6" stop-opacity="0"/></radialGradient>
    <radialGradient id="road-lamp"><stop offset="0" stop-color="#ffd27a"/><stop offset=".25" stop-color="#ffae1a" stop-opacity=".6"/><stop offset="1" stop-color="#ffae1a" stop-opacity="0"/></radialGradient>
  </defs>
  <rect width="1600" height="400" fill="url(#road-sky)"/>
  <rect y="250" width="1600" height="150" fill="url(#road-haze)"/>
  {# Sugarcane silhouette on the horizon #}
  <path d="M0 400 L0 364 L40 368 L80 361 L120 365 L160 365 L200 369 L240 362 L280 373 L320 366 L360 370 L400 363 L440 363 L480 367 L520 360 L560 371 L600 364 L640 368 L680 361 L720 372 L760 365 L800 369 L840 369 L880 362 L920 366 L960 359 L1010 396 L1030 396 L1080 367 L1120 367 L1160 371 L1200 364 L1240 368 L1280 368 L1320 361 L1360 365 L1400 365 L1440 369 L1480 362 L1520 366 L1560 366 L1600 370 L1600 400Z" fill="#0a0c0b" stroke="#0a0c0b" stroke-linejoin="round" stroke-width="6"/>
  <g transform="translate(220 0)">
  {# Fields #}
  <rect x="-400" y="400" width="2400" height="500" fill="#0b0f0a"/>
  <path d="M0 900 L760 400 L840 400 L1600 900Z" fill="url(#road-tarmac)"/>
  <rect x="-400" y="400" width="2400" height="500" fill="url(#road-beam)"/>
  {# Edge lines #}
  <path d="M110 900 L770 400" stroke="#d8d4ca" stroke-opacity=".7" stroke-width="5"/>
  <path d="M1490 900 L830 400" stroke="#d8d4ca" stroke-opacity=".7" stroke-width="5"/>
  {# Centre dashes, smaller towards the horizon #}
  {% for d in [[900, 790, 14], [745, 690, 9], [640, 607, 6], [566, 545, 4], [512, 497, 3], [471, 461, 2], [440, 433, 1.5]] %}
    {% set w1 = (d[0] - 400) * 0.03 %}{% set w2 = (d[1] - 400) * 0.03 %}
    <path d="M{{ 800 - w1 }} {{ d[0] }} L{{ 800 + w1 }} {{ d[0] }} L{{ 800 + w2 }} {{ d[1] }} L{{ 800 - w2 }} {{ d[1] }}Z" fill="#efece4" fill-opacity=".9"/>
  {% endfor %}
  {# Streetlights on the left verge #}
  {% for l in [[420, 250, 60], [610, 330, 34], [700, 365, 20], [745, 382, 12]] %}
    <circle cx="{{ l[0] }}" cy="{{ l[1] }}" r="{{ l[2] }}" fill="url(#road-lamp)"/>
    <ellipse cx="{{ l[0] + 40 }}" cy="{{ 400 + (400 - l[1]) * 1.4 }}" rx="{{ l[2] * 4 }}" ry="{{ l[2] * 0.9 }}" fill="#ffae1a" fill-opacity=".12"/>
  {% endfor %}
  </g>
</svg>
