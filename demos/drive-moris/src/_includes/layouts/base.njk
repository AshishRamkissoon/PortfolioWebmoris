<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }} — demo</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script src="/boot.js"></script>
  {# Preload the font so headings don't reflow when it arrives (layout shift). #}
  <link rel="preload" href="/assets/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  {% if preload %}{% preloadImage preload.key, preload.sizes, preload.widths %}{% endif %}
  <link rel="stylesheet" href="/assets/fonts.css">
  <link rel="stylesheet" href="/assets/main.css">
  {# Demo kit: badge styles and tour content load with the page, so the badge shows at once. #}
  <link rel="stylesheet" href="/demo-kit.css">
  <link rel="preload" href="/demo-tour.json" as="fetch" crossorigin="anonymous">
  <script type="module" src="/assets/js/main.js"></script>
</head>
<body class="{{ bodyClass }}{% if section != 'book' %} has-cta-bar{% endif %}">
  {# First in <body> and synchronous: the demo bar exists before first paint (no layout shift). #}
  <script src="/demo-kit.js"
          data-template="{{ site.templateSlug }}" data-agency="{{ site.agencyUrl }}" data-lang="{{ site.lang }}"></script>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-16 focus:left-4 focus:z-50 focus:rounded-full focus:bg-coral-500 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" class="pt-[4.5rem]">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% if section != "book" %}
    {# Phones: the booking action is always one tap away. #}
    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 px-4 py-3 shadow-[0_-8px_24px_-12px_rgb(15_36_51/0.25)] backdrop-blur md:hidden" data-cta-bar>
      <div class="flex items-center justify-between gap-3">
        <p class="text-sm leading-tight"><span class="block text-ink-500">Cars from</span><span class="font-extrabold">Rs 1,400 /day</span></p>
        <a href="/book/" class="btn btn-primary px-6">Book now</a>
      </div>
    </div>
  {% endif %}
</body>
</html>
