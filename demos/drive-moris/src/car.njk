---
layout: layouts/base.njk
section: fleet
pagination:
  data: fleet.cars
  size: 1
  alias: car
permalink: "/cars/{{ car.slug }}/"
eleventyComputed:
  title: "{{ car.name }}"
  description: "Rent a {{ car.name }} in Mauritius with Drive Moris: {{ car.seats }} seats, {{ car.gearbox | lower }}, full insurance included. Example price {{ car.price | money }} a day."
---
{% from "partials/icon.njk" import icon %}
<section class="container-x py-10">
  <nav class="text-sm text-ink-500" aria-label="Breadcrumb"><a href="/fleet/" class="hover:text-lagoon-700">Our cars</a> / <span class="text-ink-900">{{ car.name }}</span></nav>

  <div class="mt-6 grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:items-start">
    <div>
      <div class="overflow-hidden rounded-[1.5rem] bg-sand-100">
        <div class="aspect-[16/10]">{% picture car.photos[0], car.name + " from the front", "(min-width: 1024px) 60vw, 100vw", { widths: [480, 960, 1440], eager: true } %}</div>
      </div>
      {% if car.photos.length > 1 %}
        <div class="mt-4 overflow-hidden rounded-[1.5rem] bg-sand-100">
          <div class="aspect-[16/8]">{% picture car.photos[1], car.name + " from the back", "(min-width: 1024px) 60vw, 100vw", { widths: [480, 960, 1440] } %}</div>
        </div>
      {% endif %}

      <h2 class="mt-12 text-2xl">What you get</h2>
      <ul class="mt-5 grid gap-3 sm:grid-cols-2">
        {% for item in ["Zero-excess insurance", "Unlimited kilometres", "Airport pick-up and drop-off", "24/7 roadside help", "Free cancellation up to 24 h", "Taxes included"] %}
          <li class="flex items-center gap-3 text-ink-700">{{ icon("check", "size-5 text-lagoon-600") }}{{ item }}</li>
        {% endfor %}
      </ul>
    </div>

    {# Summary card #}
    <aside class="card p-7 lg:sticky lg:top-28">
      <p class="chip">{{ car.class | className(fleet.classes) }}</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{{ car.name }}</h1>
      <p class="mt-2 text-ink-500">{{ car.line }}</p>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {% for spec in [["seat", "Seats", car.seats], ["bag", "Bags", car.bags], ["door", "Doors", car.doors], ["gear", "Gearbox", car.gearbox]] %}
          <div class="flex items-center gap-3 rounded-xl bg-sand-100 p-3">
            <span class="text-lagoon-700">{{ icon(spec[0], "size-5") }}</span>
            <div><dt class="text-xs text-ink-500">{{ spec[1] }}</dt><dd class="font-bold">{{ spec[2] }}</dd></div>
          </div>
        {% endfor %}
      </dl>
      <div class="mt-6 flex items-end justify-between border-t border-line pt-5">
        <p class="text-sm text-ink-500">From<span class="block text-3xl font-extrabold text-ink-900">{{ car.price | money }}<span class="text-base font-semibold text-ink-500"> /day</span></span></p>
      </div>
      <a href="/book/?car={{ car.slug }}" class="btn btn-primary mt-5 w-full py-3.5 text-base">Book this car</a>
      <p class="mt-3 text-center text-xs text-ink-500">No payment now · Deposit {{ site.deposit | money }} held on your card</p>
    </aside>
  </div>
</section>

<section class="bg-sand-100 py-16">
  <div class="container-x">
    <h2 class="text-2xl sm:text-3xl">Other cars you might like</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {% set related = fleet.cars | others(car.slug) | limit(3) %}
      {% asyncEach car in related %}
        {% include "partials/car-card.njk" %}
      {% endeach %}
    </div>
  </div>
</section>
