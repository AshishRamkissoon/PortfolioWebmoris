---
layout: layouts/base.njk
title: Our cars
section: fleet
description: The Drive Moris fleet — city cars, SUVs, 7-seaters and an open top, all with full insurance included.
---
<section class="bg-linear-to-b from-lagoon-50 to-white">
  <div class="container-x py-12 sm:py-16">
    <p class="hero-rise eyebrow">Our cars</p>
    <h1 class="hero-rise mt-2 text-4xl [animation-delay:80ms] sm:text-5xl">Find the right car for your trip</h1>
    <p class="hero-rise lead mt-4 max-w-2xl [animation-delay:160ms]">Well-kept everyday cars. Every price includes zero-excess insurance, unlimited kilometres and airport pick-up. Example prices per day.</p>
  </div>
</section>

<nav class="sticky z-30 border-y border-line bg-white/95 backdrop-blur" style="top: calc(var(--demo-bar-h, 0px) + 4.5rem)" aria-label="Car types" data-filters>
  <div class="container-x flex items-center gap-2 overflow-x-auto py-3 [scrollbar-width:none]">
    <a href="/fleet/" class="filter-btn" data-filter="all" aria-pressed="true">All cars</a>
    {% for class in fleet.classes %}<a href="/fleet/?class={{ class.slug }}" class="filter-btn" data-filter="{{ class.slug }}" aria-pressed="false">{{ class.name }}</a>{% endfor %}
    <p class="ml-auto shrink-0 pl-4 text-sm text-ink-500"><span class="font-bold text-ink-900" data-fleet-count>{{ fleet.cars | length }}</span> cars</p>
  </div>
</nav>

<section class="container-x py-12">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-fleet>
    {% asyncEach car in fleet.cars %}
      {% set eager = loop.index <= 4 %}
      {% include "partials/car-card.njk" %}
    {% endeach %}
  </div>
</section>
