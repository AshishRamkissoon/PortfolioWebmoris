---
layout: layouts/base.njk
title: Fleet
section: fleet
description: The Drive Moris fleet — city cars, SUVs, 7-seaters and an open top, all with full insurance included.
preload: { key: "swift-1", sizes: "(min-width: 1024px) 40vw, 100vw", widths: [480, 960, 1440] }
---
<section class="container-x pt-40 pb-16 sm:pt-48">
  <p class="hero-rise label-km">The garage · {{ fleet.cars | length }} cars</p>
  <h1 class="hero-rise mt-6 text-[clamp(4rem,12vw,11rem)] [animation-delay:100ms]">The <span class="text-sodium">fleet.</span></h1>
  <p class="hero-rise mt-6 max-w-xl text-lg text-road/75 [animation-delay:200ms]">Everyday cars, well kept. Every price includes zero-excess insurance and unlimited kilometres. Example prices per day.</p>
</section>

<nav class="sticky z-30 border-y border-kerb bg-tarmac/90 backdrop-blur-md" style="top: calc(var(--demo-bar-h, 0px) + 5rem)" aria-label="Car types" data-filters>
  <div class="container-x flex items-center gap-2 overflow-x-auto py-4 [scrollbar-width:none]">
    <a href="/fleet/" class="filter-btn shrink-0" data-filter="all" aria-pressed="true">All</a>
    {% for class in fleet.classes %}<a href="#{{ class.slug }}" class="filter-btn shrink-0" data-filter="{{ class.slug }}" aria-pressed="false">{{ class.name }}</a>{% endfor %}
    <p class="ml-auto shrink-0 pl-4 font-mono text-xs text-dust"><span class="text-road" data-fleet-count>{{ fleet.cars | length | pad }}</span> cars</p>
  </div>
</nav>

<ol class="container-x py-12" data-fleet>
  {% asyncEach car in fleet.cars %}
    <li id="{{ car.class }}" class="group grid scroll-mt-48 gap-6 border-b border-kerb py-10 md:grid-cols-[1.25fr_1fr] md:items-center md:gap-12" data-class="{{ car.class }}">
      <a href="/cars/{{ car.slug }}/" class="letterbox block" aria-label="{{ car.name }} details">
        <div class="absolute inset-0 transition duration-[1.2s] ease-[var(--ease-arrive)] group-hover:scale-[1.04]">{% picture car.photos[0], car.name, "(min-width: 768px) 55vw, 100vw", { widths: [480, 960, 1440], eager: loop.first } %}</div>
      </a>
      <div>
        <p class="font-mono text-xs tracking-[0.2em] text-dust uppercase">{{ loop.index | pad }} · {{ car.class | className(fleet.classes) }}</p>
        <h2 class="mt-2 text-5xl sm:text-6xl"><a href="/cars/{{ car.slug }}/" class="transition hover:text-sodium">{{ car.name }}</a></h2>
        <p class="mt-3 max-w-sm text-road/70">{{ car.line }}</p>
        <p class="mt-5 flex flex-wrap gap-x-6 gap-y-1 font-mono text-sm text-road/80">
          <span>{{ car.seats }} seats</span><span>{{ car.bags }} bags</span><span>{{ car.gearbox }}</span><span>Air con</span>
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <p class="font-mono text-3xl text-sodium tabular-nums">{{ car.price | money }}<span class="text-sm text-dust"> /day</span></p>
          <a href="/book/?car={{ car.slug }}" class="btn btn-line ml-auto px-5 py-3">Book →</a>
        </div>
      </div>
    </li>
  {% endeach %}
</ol>
