---
layout: layouts/base.njk
title: Book a car
section: book
description: Book a rental car at Mauritius airport. See the full price for your dates, car and extras before you send the request.
---
{% from "partials/icon.njk" import icon %}
<section class="relative overflow-hidden bg-linear-to-br from-lagoon-900 via-lagoon-800 to-lagoon-600 text-white">
  <div class="absolute -top-24 -right-24 size-96 rounded-full bg-turquoise-400/25 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 left-1/3 size-80 rounded-full bg-coral-500/25 blur-3xl" aria-hidden="true"></div>
  <div class="container-x py-10 sm:py-14">
    <p class="hero-rise eyebrow relative text-sun-400">Book a car</p>
    <h1 class="hero-rise relative mt-2 text-4xl [animation-delay:80ms] sm:text-6xl">Book your car in <span class="text-gradient-light">4 easy steps</span></h1>
    <p class="hero-rise relative mt-3 max-w-2xl text-lg text-white/85 [animation-delay:160ms]">The full price updates as you go. No payment now: we confirm by email within the hour.</p>
  </div>
</section>

<form class="container-x grid gap-10 pt-10 pb-20 lg:grid-cols-[1.6fr_1fr] lg:items-start" action="/book/" method="post" data-trip>
  <div class="space-y-6">
    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">When and where</legend>
      <h2 class="flex items-center gap-3 text-xl"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-coral-500 to-sun-400 text-sm text-white">1</span>When and where</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <span class="field-label">Pick-up</span>
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,9rem)] gap-2">
            <input class="field min-w-0" type="date" name="pickup_date" aria-label="Pick-up date" required>
            <input class="field min-w-0 px-3" type="time" name="pickup_time" aria-label="Pick-up time" value="10:00">
          </div>
          <select class="field mt-2" name="pickup_place" aria-label="Pick-up place">{% for place in site.places %}<option value="{{ place.value }}">{{ place.label }}{% if place.fee %} (+{{ place.fee | money }}){% endif %}</option>{% endfor %}</select>
        </div>
        <div>
          <span class="field-label">Return</span>
          <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,9rem)] gap-2">
            <input class="field min-w-0" type="date" name="return_date" aria-label="Return date" required>
            <input class="field min-w-0 px-3" type="time" name="return_time" aria-label="Return time" value="10:00">
          </div>
          <select class="field mt-2" name="return_place" aria-label="Return place">{% for place in site.places %}<option value="{{ place.value }}">{{ place.label }}{% if place.fee %} (+{{ place.fee | money }}){% endif %}</option>{% endfor %}</select>
        </div>
      </div>
    </fieldset>

    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">Your car</legend>
      <h2 class="flex items-center gap-3 text-xl"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-coral-500 to-sun-400 text-sm text-white">2</span>Choose your car</h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {% asyncEach car in fleet.cars %}
          <label class="relative flex cursor-pointer items-center gap-3 rounded-2xl border border-line p-3 transition hover:border-ink-300 has-[:checked]:border-lagoon-600 has-[:checked]:bg-lagoon-50 has-[:checked]:ring-2 has-[:checked]:ring-lagoon-100">
            <input type="radio" name="car" value="{{ car.slug }}" class="peer sr-only" {% if loop.first %}checked{% endif %}>
            <span class="block h-14 w-20 shrink-0 overflow-hidden rounded-lg">{% picture car.photos[0], "", "80px", { widths: [480] } %}</span>
            <span class="min-w-0 flex-1">
              <span class="block font-bold">{{ car.name }}</span>
              <span class="block text-xs text-ink-500">{{ car.seats }} seats · {{ car.gearbox }}</span>
            </span>
            <span class="text-sm font-bold text-lagoon-700">{{ car.price | money }}</span>
          </label>
        {% endeach %}
      </div>
    </fieldset>

    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">Extras</legend>
      <h2 class="flex items-center gap-3 text-xl"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-coral-500 to-sun-400 text-sm text-white">3</span>Add extras <span class="text-sm font-semibold text-ink-500">(optional)</span></h2>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {% for extra in site.extras %}
          <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-line p-4 transition hover:border-ink-300 has-[:checked]:border-lagoon-600 has-[:checked]:bg-lagoon-50">
            <input type="checkbox" name="extras" value="{{ extra.value }}" class="mt-1 size-4 accent-[#0e6e8c]">
            <span class="flex-1"><span class="block font-bold">{{ extra.label }}</span><span class="block text-sm text-ink-500">{{ extra.note }}</span></span>
            <span class="text-sm font-bold whitespace-nowrap">{{ extra.price | money }}/{{ extra.per }}</span>
          </label>
        {% endfor %}
      </div>
    </fieldset>

    <fieldset class="card p-6 sm:p-7">
      <legend class="sr-only">Your details</legend>
      <h2 class="flex items-center gap-3 text-xl"><span class="grid size-8 place-items-center rounded-full bg-linear-to-br from-coral-500 to-sun-400 text-sm text-white">4</span>Your details</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div><label class="field-label" for="name">Full name</label><input class="field" id="name" name="name" required autocomplete="name"></div>
        <div><label class="field-label" for="email">Email</label><input class="field" id="email" name="email" type="email" required autocomplete="email"></div>
        <div><label class="field-label" for="phone">Phone / WhatsApp</label><input class="field" id="phone" name="phone" type="tel" autocomplete="tel"></div>
        <div><label class="field-label" for="flight">Flight number (optional)</label><input class="field" id="flight" name="flight" placeholder="So we wait if you're late"></div>
      </div>
    </fieldset>
  </div>

  {# Booking summary (live when JS runs) #}
  <aside class="lg:sticky lg:top-28">
    <div class="card p-7" data-ticket hidden aria-live="polite">
      <h2 class="text-xl">Your booking</h2>
      <p class="mt-4 text-2xl font-extrabold" data-out="car">—</p>
      <p class="mt-1 text-sm text-ink-500" data-out="dates">—</p>
      <dl class="mt-5 space-y-3 border-t border-line pt-5 text-sm">
        <div class="flex justify-between"><dt class="text-ink-500">Days</dt><dd class="font-semibold" data-out="days">0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Daily rate</dt><dd class="font-semibold" data-out="rate">Rs 0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Rental</dt><dd class="font-semibold" data-out="rental">Rs 0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Extras</dt><dd class="font-semibold" data-out="extras">Rs 0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Delivery</dt><dd class="font-semibold" data-out="delivery">Rs 0</dd></div>
        <div class="flex justify-between"><dt class="text-ink-500">Insurance</dt><dd class="font-semibold text-lagoon-700">Included</dd></div>
      </dl>
      <div class="mt-5 flex items-end justify-between rounded-2xl bg-linear-to-br from-lagoon-700 to-lagoon-500 p-4 text-white">
        <p class="font-bold">Total</p>
        <p class="text-3xl font-extrabold" data-out="total">Rs 0</p>
      </div>
      <p class="mt-3 text-sm font-semibold text-coral-600" data-out="warning" hidden>The return must be after the pick-up.</p>
      <button type="submit" class="btn btn-primary mt-5 w-full py-3.5 text-base" data-magnetic>Request this car</button>
      <ul class="mt-4 space-y-1.5 text-xs text-ink-500">
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-lagoon-600") }}No payment now</li>
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-lagoon-600") }}Deposit {{ site.deposit | money }} held on your card</li>
        <li class="flex items-center gap-2">{{ icon("check", "size-4 text-lagoon-600") }}Example prices (demo)</li>
      </ul>
    </div>

    {# Without JS: the rates, and a plain submit button #}
    <div class="card p-7" data-ticket-fallback>
      <h2 class="text-xl">Daily rates</h2>
      <table class="mt-4 w-full text-sm">
        <tbody>{% for car in fleet.cars %}<tr class="border-b border-line"><td class="py-2">{{ car.name }}</td><td class="py-2 text-right font-bold">{{ car.price | money }}</td></tr>{% endfor %}</tbody>
      </table>
      <button type="submit" class="btn btn-primary mt-5 w-full">Request this car</button>
    </div>
  </aside>
</form>

<script type="application/json" id="trip-data">{"cars": [{% for car in fleet.cars %}{"slug": "{{ car.slug }}", "name": "{{ car.name }}", "price": {{ car.price }}}{% if not loop.last %}, {% endif %}{% endfor %}], "extras": [{% for e in site.extras %}{"value": "{{ e.value }}", "price": {{ e.price }}, "per": "{{ e.per }}"}{% if not loop.last %}, {% endif %}{% endfor %}], "places": [{% for p in site.places %}{"value": "{{ p.value }}", "fee": {{ p.fee }}}{% if not loop.last %}, {% endif %}{% endfor %}]}</script>
