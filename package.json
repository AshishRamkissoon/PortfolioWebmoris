{
  "name": "webmoris",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:fonts && concurrently -n css,js -c cyan,magenta \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "tailwindcss -i frontend/src/css/main.css -o static/dist/main.css --watch",
    "dev:js": "esbuild frontend/src/js/main.js --bundle --format=esm --splitting --outdir=static/dist --sourcemap --watch",
    "build": "npm run build:fonts && npm run build:css && npm run build:js",
    "build:fonts": "esbuild frontend/src/css/fonts.css --bundle --minify --loader:.woff2=file --loader:.woff=file --asset-names=fonts/[name]-[hash] --outdir=static/dist",
    "build:css": "tailwindcss -i frontend/src/css/main.css -o static/dist/main.css --minify",
    "build:js": "esbuild frontend/src/js/main.js --bundle --format=esm --splitting --outdir=static/dist --minify"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.17.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "gsap": "^3.15.0",
    "htmx.org": "^2.0.11",
    "lenis": "^1.3.27",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
