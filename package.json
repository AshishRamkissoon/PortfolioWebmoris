{
  "name": "webmoris",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n css,js -c cyan,magenta \"npm:dev:css\" \"npm:dev:js\"",
    "dev:css": "tailwindcss -i frontend/src/css/main.css -o static/dist/main.css --watch",
    "dev:js": "esbuild frontend/src/js/main.js --bundle --format=esm --splitting --outdir=static/dist --sourcemap --watch",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i frontend/src/css/main.css -o static/dist/main.css --minify",
    "build:js": "esbuild frontend/src/js/main.js --bundle --format=esm --splitting --outdir=static/dist --minify"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "gsap": "^3.15.0",
    "htmx.org": "^2.0.11",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
