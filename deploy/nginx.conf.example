# /etc/nginx/sites-available/webmoris — HTTPS via Let's Encrypt (certbot --nginx).
server {
    listen 80;
    server_name webmoris.example www.webmoris.example;
    return 301 https://webmoris.example$request_uri;
}

server {
    listen 443 ssl http2;
    server_name webmoris.example;

    # ssl_certificate / ssl_certificate_key are added by certbot.

    # Quote attachments are 10 MB max; project videos up to 50 MB (admin uploads).
    client_max_body_size 55m;

    # Public uploads (project images, videos). Never execute or sniff them.
    location /media/ {
        alias /srv/webmoris/app/media/;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=2592000";
    }
    # Note: private_media/ (attachments, payment proofs) is deliberately NOT served.
    # Static files are served by WhiteNoise (compressed, cache-busted) through Gunicorn.

    location / {
        proxy_pass http://unix:/run/webmoris/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
